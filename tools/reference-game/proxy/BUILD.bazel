# The proxy and its fixtures run inside x86 images and use four-byte pointers
# or x86 machine-code stubs. This is a fixture contract, not a toolchain limit.
_X86_WINDOWS = ["@platforms//os:windows", "@platforms//cpu:x86_32"]

# Hook adapters: header-only glue between the original calling conventions
# and core/. Included by media_proxy.c, the fixtures below and invitro/.
# Their machine calls (machine_call.h) need one es2_machine_call backend:
# hook_adapters brings the x86 one; es2sim takes hook_adapter_headers with
# the sim backend of //sim:dispatch.
cc_library(
    name = "hook_adapter_headers",
    # Every *_hooks.h is an adapter header; rng_hooks.h includes them in the
    # group order of the registry through the generated hook_group_adapters.h.
    textual_hdrs = glob(["*_hooks.h"]) + [
        "callee_counters.h",
        "entry_shim.h",
        "entry_shims.h",
        "guest_native.h",
        "hook_registry.h",
        "hook_registry_ids.h",
        "adapter_host.h",
        "machine_call.h",
        "present_site.h",
        ":hook_group_adapters",
    ],
    deps = ["//hook:descriptor", "//hook:machine", "//core", "//platform:os"],
    # Also in es2sim's wasm build (//sim:es2sim_wasm).
    target_compatible_with = select({
        "@platforms//os:emscripten": [],
        "//conditions:default": _X86_WINDOWS,
    }),
)

# The proxy's part: the installation over the x86 framework (hook_install.h,
# which rng_hooks.h includes outside es2sim) and the naked entry capture.
cc_library(
    name = "hook_adapters",
    textual_hdrs = ["actor_pass_snapshot.h", "entry_shims_x86.h", "hook_install.h"],
    deps = [":hook_adapter_headers", "//hook", "//hook:machine_x86"],
    target_compatible_with = _X86_WINDOWS,
)

# rng_hooks.h's include chain, derived from the registry (hook_groups.py).
hook_group_header(
    name = "hook_group_adapters",
    kind = "adapters",
    registry = "hook_registry.h",
    headers = glob(["*_hooks.h"]),
    prefix = "tools/reference-game/proxy",
    exclude = ["rng_hooks.h"],
)

exports_files(["hook_groups.py", "hook_registry.h", "live_coverage_edges.h", "probe_entry_inventory.h", "entry_probe_engine.h"])

# Sources of the generated legacy counter dispatch (scripts/legacy_graph_counters.py):
# the registry, callee_counters.h and every adapter header that may define a
# <group>_hook_counters function. Test data only.
filegroup(
    name = "counter_sources",
    srcs = glob(["*_hooks.h"]) + ["callee_counters.h", "hook_registry.h"],
)

# Runtime instrumentation, also header-only.
cc_library(
    name = "instrumentation",
    textual_hdrs = [
        "input_journal.h",
        "window_shim.h",
        "mem_watch.h",
        "mission_map_guard.h",
        "tick_log.h",
        "virtual_time.h",
        "oracle_perf.h",
        "oracle_perf_runtime.h",
        "tick_log_io.h",
        "ddraw_observer.h",
        "presenter.h",
        "presenter_frame.h",
        "sha256.h",
        "ddraw_windowed.h",
        "vshell_capture.h",
        "vshell_journal.h",
        "frame_regions.h",
        "present_site.h",
    ],
    # virtual_time.h and tick_log.h use the shared oracle libraries;
    # input_journal.h uses //sim/oracle:journal; mem_watch.h uses
    # //sim/oracle:mem_watch.
    deps = ["//sim/oracle:virtual_time", "//sim/oracle:tick_record", "//sim/oracle:journal", "//sim/oracle:mem_watch"],
    target_compatible_with = _X86_WINDOWS,
)

# The CW3220 import shim (rtl_imports.h, docs/reference-game/rtl_imports.md);
# rtl_heap_shadow.h, the heap shadow over core/src/rtl_heap.c;
# rtl_io_shadow.h, the file and console imports over core/src/rtl_io.c;
# rtl_heap_own.h, the heap imports replaced by the own heap;
# rtl_life.h, the lifecycle group over core/src/rtl_start.c.
cc_library(
    name = "rtl_imports",
    textual_hdrs = ["rtl_imports.h", "rtl_heap_shadow.h", "rtl_heap_own.h", "rtl_io_shadow.h", "rtl_life.h", "sha256.h"],
    deps = ["//hook", "//core:rtl", "//core:rtl_heap", "//core:rtl_io", "//core:rtl_start", "//rtl:own_runtime_header"],
    target_compatible_with = _X86_WINDOWS,
)

# This is deliberately a host-OS step: system DLL and Python executable are
# digest-tracked local-repository files. Python runtime/stdlib remain external.
# No SDK/compiler/runtime is installed, copied into source, or downloaded.
system_ddraw_exports(
    name = "system_exports",
    generator = "generate_exports.py",
    python = "@proxy_host//:python.exe",
    python_path = HOST_PYTHON,
    readobj = "@llvm_mingw//:sdk/bin/llvm-readobj.exe",
    readobj_runtime = "@llvm_mingw//:tools",
    system_ddraw = "@proxy_host//:ddraw.dll",
    tags = ["local", "no-remote"],
    target_compatible_with = _X86_WINDOWS,
)

filegroup(name = "exports_header", srcs = [":system_exports"], output_group = "header")
filegroup(name = "exports_assembly", srcs = [":system_exports"], output_group = "assembly")
filegroup(name = "exports_definition", srcs = [":system_exports"], output_group = "definition")

# The deployed DLL. Scripts build it through setup/Es2Bazel.psm1; its SHA-256
# is recorded in every installation manifest and oracle evidence report.
cc_binary(
    name = "ddraw.dll",
    srcs = [
        "media_proxy.c",
        ":exports_header",
        ":exports_assembly",
    ],
    deps = [":hook_adapters", ":instrumentation", ":live_coverage", ":rtl_imports", ":vol_probe_headers", ":early_arming", ":bwcc32_switch", ":new_fail_switch", ":fault_trace", "//media:iv32_bind", ":vshell_probe_headers", ":call_probe"],
    copts = [
        "-std=c17",
        "-Wno-cast-function-type-strict",
        "-mstackrealign",
        "-I$(GENDIR)/tools/reference-game/proxy/system_exports",
    ],
    additional_linker_inputs = [":exports_definition"],
    linkopts = ["-Wl,--no-insert-timestamp", "-Wl,--wrap=es2_hook_dispatch_extended", "$(location :exports_definition)", "-ladvapi32", "-lgdi32"],
    linkshared = True,
    linkstatic = True,
    target_compatible_with = _X86_WINDOWS,
)

