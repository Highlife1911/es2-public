# Unit tests that need more than the short timeout on a loaded machine
# (branch_edges: 27 s alone, over 180 s in the full quick tier).
_UNIT_TEST_SIZES = {
    "branch_edges": "medium",
    "dbsim_data": "medium",
}

[host_python_test(
    name = name + "_unit_test",
    main = "tests/test_%s.py" % name,
    data = modules,
    size = _UNIT_TEST_SIZES.get(name, "small"),
) for name, modules in _UNIT_TESTS.items()]

# The presentation-capture acceptance passes (presenter_capture.py) on
# synthetic captures and dumps; pass 3 runs the DLL's conversion and scaler
# through //tools/reference-game/proxy:presenter_offline.
host_python_test(
    name = "presenter_capture_unit_test",
    main = "tests/test_presenter_capture.py",
    data = ["presenter_capture.py", "//tools/reference-game/proxy:presenter_offline"],
    args = ["$(rootpath //tools/reference-game/proxy:presenter_offline)"],
    target_compatible_with = ["@platforms//os:windows", "@platforms//cpu:x86_32"],
)
