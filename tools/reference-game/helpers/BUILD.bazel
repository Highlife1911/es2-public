load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

# Standalone own x86 helpers that observe or probe the original game from
# outside its process. Scripts build them through setup/Es2Bazel.psm1.
_X86_WINDOWS = ["@platforms//os:windows", "@platforms//cpu:x86_32"]

# Debugger-based crash collector for START_ES2_DIAGNOSE.cmd (setup/start-native.ps1 -CaptureCrash).
cc_binary(
    name = "capture_crash",
    srcs = ["capture_crash.c"],
    copts = ["-Wno-cast-function-type-strict"],
    linkopts = ["-municode"],
    target_compatible_with = _X86_WINDOWS,
)

# Read-only snapshot of a stalled game (setup/run-tick-log-mission.ps1 -SnapshotOnStall).
cc_binary(
    name = "hang_snapshot",
    srcs = ["hang_snapshot.c"],
    linkopts = ["-municode"],
    target_compatible_with = _X86_WINDOWS,
)

# Media decode probe used by setup/validate-media.ps1.
cc_binary(
    name = "probe_media",
    srcs = ["probe_media.c"],
    linkopts = ["-lvfw32", "-lgdi32", "-luser32", "-lwinmm", "-lddraw"],
    target_compatible_with = _X86_WINDOWS,
)

# Fixture for tests/test_capture_crash.ps1; -O1 keeps its fault sites simple.
cc_binary(
    name = "capture_crash_fixture",
    srcs = ["tests/capture_crash_fixture.c"],
    copts = ["-O1"],
    linkopts = ["-municode"],
    target_compatible_with = _X86_WINDOWS,
)

# Lowers the audio session volume of a running DBSIM from outside the
# process (setup/run-tick-log-mission.ps1 -VolumePercent: quiet test runs).
cc_binary(
    name = "session_volume",
    srcs = ["session_volume.c"],
    linkopts = ["-municode", "-lole32", "-luuid"],
    target_compatible_with = _X86_WINDOWS,
)

cc_test(
    name = "session_volume_test",
    srcs = ["tests/session_volume_test.c"],
    args = ["$(rootpath :session_volume)"],
    data = [":session_volume"],
    linkopts = ["-municode"],
    target_compatible_with = _X86_WINDOWS,
)
