load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

# Standalone own x86 helpers that observe or probe the original game from
# outside its process. Scripts build them through setup/Es2Bazel.psm1.
_X86_WINDOWS = ["@platforms//os:windows", "@platforms//cpu:x86_32"]

# Media decode probe used by setup/validate-media.ps1.
cc_binary(
    name = "probe_media",
    srcs = ["probe_media.c"],
    linkopts = ["-lvfw32", "-lgdi32", "-luser32", "-lwinmm", "-lddraw"],
    target_compatible_with = _X86_WINDOWS,
)
