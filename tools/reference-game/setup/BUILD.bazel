load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel/defs:python_test.bzl", "host_python_test")
load("//bazel/platforms:host_tools.bzl", "HOST_PWSH", "HOST_PYTHON")

# PowerShell scripts used as test data by //tools/reference-game/proxy:live_coverage_scripts_test.
exports_files(["run-live-coverage.ps1"])

# PowerShell script tests carry the tag "scripts": `bazel test //... --test_tag_filters=-scripts`
# skips them during development (docs/reference-game/setup.md). Each starts one PowerShell
# process per lane instead of one per step (pwsh_session.py).
exports_files(["pwsh_session.py"])

cc_test(
    name = "suite_scripts_test",
    srcs = ["suite_scripts_fixture.c"],
    data = [
        "test_suite_scripts.py",
        "pwsh_session.py",
        "SuiteLaunch.psm1",
        "capture-launch-set.ps1",
        "run-prepared-suite.ps1",
        "record-suite.ps1",
        "run-oracle-regression.ps1",
        "run-mission-outcome.ps1",
        "run-draft-coverage.ps1",
        "run-draft-oracle-bridge.ps1",
        # capture-vshell-screens.ps1 with the mock game as VSHELL.EXE, the layout table and the tour.
        "capture-vshell-screens.ps1",
        "CloneGuard.psm1",
        ":clone_guard_mock_game",
        "//shell:data/vshell_layout.json",
        "//formats:player_mec_tool",
        "//tools/reference-game:oracle-suites.json",
        # The player.mec case reads the CD at ES2_DATA_ROOT (content-tracked).
        "@es2_data//:cd",
    ],
    args = [
        HOST_PYTHON,
        "$(rootpath test_suite_scripts.py)",
        "$(rootpath run-oracle-regression.ps1)",
        "$(rootpath //formats:player_mec_tool)",
    ],
    env = {"ES2_PWSH": HOST_PWSH, "ES2_MOCK_GAME": "$(rootpath :clone_guard_mock_game)"},
    # Like the existing live-coverage fixture, resolve the actual runner source
    # path and inspect its sibling scripts/registry. Local and never cached.
    tags = ["local", "no-remote", "no-cache", "scripts"],
    # 14 lanes at 40 suites (each with a synthetic DataRoot of its own; the registered suites run in
    # groups of 10 per lane), 7 shards (lane i runs in shard i % 7; the test file lists the order; lane_environment is
    # lane 13, beside lane_dry in shard 6).
    shard_count = 7,
    size = "medium",
    target_compatible_with = ["@platforms//os:windows"],
)

# Scripts used as test data by //tools/reference-game/proxy:oracle_speed_scripts_test.
exports_files([
    "run-tick-log-mission.ps1", "configure-tick-log.ps1", "Es2Bazel.psm1",
    "new-measurement-clone.ps1", "run-oracle-parallel.ps1", "start-timing-mission.ps1",
])

exports_files(["CloneGuard.psm1"])

# //tools:check_script_test deploys the own runtime on a synthetic clone with it.
exports_files(["configure-runtime.ps1"])

# Stand-in game process for clone_guard_test (own code, sleeps and exits).
cc_binary(
    name = "clone_guard_mock_game",
    srcs = ["clone_guard_mock_game.c"],
    linkopts = ["-luser32"],
    target_compatible_with = ["@platforms//os:windows"],
)

# Clone guard: per-clone lock, own-child wait/stop with verified PID,
# path and start time, refusals naming the foreign process or lock holder.
# Starts only the mock game above under a synthetic clone; never a game.
host_python_test(
    name = "clone_guard_test",
    main = "test_clone_guard.py",
    data = [
        "//tools/reference-game:oracle-suites.json",
        "pwsh_session.py",
        "CloneGuard.psm1",
        ":clone_guard_mock_game",
        "SuiteLaunch.psm1",
        "Es2Bazel.psm1",
        "configure-tick-log.ps1",
        "run-oracle-parallel.ps1",
        "run-oracle-regression.ps1",
        "run-prepared-suite.ps1",
        "start-timing-mission.ps1",
    ],
    args = [
        "$(rootpath CloneGuard.psm1)",
        "$(rootpath :clone_guard_mock_game)",
    ],
    env = {"ES2_PWSH": HOST_PWSH},
    # Like suite_scripts_test: runs the scripts from their source directory.
    tags = ["local", "no-remote", "no-cache", "scripts"],
    size = "medium",
    target_compatible_with = ["@platforms//os:windows"],
)

# capture-dbsim-frames.ps1 (the DBSIM frame capture per suite) with a mock regression child on a synthetic
# DataRoot: the capture INI it hands down, the manifests built from the capture reports it finds, refusals, the
# failure statuses and the dump selection. Never a game, installation or real clone.
host_python_test(
    name = "capture_dbsim_frames_test",
    main = "test_capture_dbsim_frames.py",
    data = [
        "capture-dbsim-frames.ps1",
        "run-oracle-parallel.ps1",
        "CloneGuard.psm1",
        "SuiteLaunch.psm1",
        "pwsh_session.py",
        "//tools/reference-game/scripts:dbsim_frames.py",
        "//tools/reference-game/scripts:presenter_capture.py",
        "//tools/reference-game/scripts:OracleSpeed.psm1",
    ],
    args = [
        "$(rootpath capture-dbsim-frames.ps1)",
        "$(rootpath run-oracle-parallel.ps1)",
        "$(rootpath //tools/reference-game/scripts:dbsim_frames.py)",
    ],
    env = {"ES2_PWSH": HOST_PWSH},
    # Like clone_guard_test: runs the scripts from their source directory.
    tags = ["local", "no-remote", "no-cache", "scripts"],
    size = "medium",
    target_compatible_with = ["@platforms//os:windows"],
)

