# start-own-menu.ps1 (one-command owner acceptance of the own menu) on synthetic installations: backup,
# restore, refusals, -DryRun, -RestoreOnly. A fixture launcher script plays the owner's session, the stand-in DBSIM of
# //shell:chain_real_test and a mock game process run in a temporary DataRoot; never a game, the menu or a real
# installation.
host_python_test(
    name = "start_own_menu_test",
    main = "test_start_own_menu.py",
    data = [
        "start-own-menu.ps1",
        "pwsh_session.py",
        "CloneGuard.psm1",
        "Es2Bazel.psm1",
        ":clone_guard_mock_game",
        "//launcher:stand_in_child",
        "//shell:tools/es2menu_backend.py",
        "//shell:tools/es2chain.py",
        "//shell:tools/es2prep.py",
        "//shell:tools/es2campaign.py",
        "//shell:tools/es2loadout.py",
        # -Unattended: the suite registry, the comparison of a run with its golden.
        "//tools/reference-game:oracle-suites.json",
        "//tools/reference-game/scripts:oracle_regression.py",
        "//tools/reference-game/scripts:mission_watch_report.py",
    ],
    args = [
        "$(rootpath start-own-menu.ps1)",
        "$(rootpath :clone_guard_mock_game)",
        "$(rootpath //launcher:stand_in_child)",
        "$(rootpath //shell:tools/es2menu_backend.py)",
    ],
    env = {"ES2_PWSH": HOST_PWSH},
    # Like clone_guard_test: runs the scripts from their source directory.
    tags = ["local", "no-remote", "no-cache", "scripts"],
    size = "medium",
    target_compatible_with = ["@platforms//os:windows", "@platforms//cpu:x86_32"],
