def group_test_name(group):
    """Test-name stem of a group. Windows' installer heuristic refuses to
    start executables whose names contain "update" or "patch" (error 740),
    so those group names are spelled differently in the test labels."""
    return group.replace("update", "upd").replace("dispatch", "disp")
