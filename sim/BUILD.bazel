# The own DBSIM process (docs/reference-game/own_process.md). The guest is
# i686: identity-mapped at its original VAs, run by the registry's adapters
# over core/, so everything here except //sim/oracle builds for the 32-bit
# Windows target only. README.md lists the seams.
package(default_visibility = ["//visibility:public"])

_X86_WINDOWS = ["@platforms//os:windows", "@platforms//cpu:x86_32"]
_COPTS = ["-std=c17", "-mstackrealign"]
# es2sim.exe and the tests that claim 0x400000: linked like the in-vitro
# harness (own image base, no dynamic base, 16 MiB initial stack, own entry
# that claims the guest range before the CRT).
_HOST_LINKOPTS = ["-Wl,--image-base,0x10000000,--disable-dynamicbase,--entry,_es2sim_start,--stack,0x1000000"]

cc_library(
    name = "image",
    srcs = ["data/dbsim_image_tables.c", "src/image.c"],
    hdrs = ["include/es2/sim/image.h"],
    strip_include_prefix = "include",
    copts = _COPTS,
    target_compatible_with = _X86_WINDOWS,
)

cc_library(
    name = "memory",
    srcs = ["src/memory.c"],
    hdrs = ["include/es2/sim/memory.h"],
    strip_include_prefix = "include",
    deps = ["//core"],
    copts = _COPTS,
    target_compatible_with = _X86_WINDOWS,
)

cc_library(
    name = "dispatch",
    srcs = ["src/dispatch.c", "src/dispatch_trap.c", "src/dispatch_trap.S"],
    hdrs = ["include/es2/sim/dispatch.h", "include/es2/sim/trap.h"],
    strip_include_prefix = "include",
    deps = ["//hook"],
    copts = _COPTS,
    target_compatible_with = _X86_WINDOWS,
)

cc_library(
    name = "host_fault",
    srcs = ["src/host_fault.c"],
    hdrs = ["include/es2/sim/host_fault.h"],
    strip_include_prefix = "include",
    copts = _COPTS,
    target_compatible_with = _X86_WINDOWS,
)

cc_library(
    name = "heap",
    srcs = ["src/heap.c", "src/heap_win32.c"],
    hdrs = ["include/es2/sim/heap.h"],
    strip_include_prefix = "include",
    deps = ["//core"],
    copts = _COPTS,
    target_compatible_with = _X86_WINDOWS,
)

# The service rows: one fragment per topic in dispatch/services/, included by
# the generated services_rows.h in file-name order (a new topic adds a file
# instead of appending to a shared list).
include_list(
    name = "services_rows",
    srcs = glob(["dispatch/services/*.h"]),
    out = "dispatch/services_rows.h",
)

# The service rows (dispatch/services.h with its fragments) and their
# functions (runtime and heap, platform, files, the main loop, the pump, the
# window procedure, the clock, the DIB section's objects and the game's own
# code behind them).
cc_library(
    name = "services",
    srcs = ["src/services_rtl.c", "src/services_platform.c", "src/services_files.c", "src/loop.c", "src/frame_buffer.c", "src/input.c", "src/load.c", "src/audio.c", "src/hud_load.c", "src/hud_cockpit.c", "src/hud_gauges.c", "src/hud_state.c", "src/hud_display.c", "src/hud_draw.c", "src/hud_internal.h", "src/view.c", "src/dialogs.c", "src/gfx.c", "src/hud_frame.c", "src/present.c", "src/poly.c", "src/scene.c", "src/terrain_draw.c", "src/shape_draw.c", "src/display.c", "src/cockpit.c", "src/hud_widgets.c", "src/gadgets.c", "src/gadgets_internal.h", "src/frustum.c", "src/mfd.c", "src/fill.c", "src/gouraud.c", "src/panel.c", "src/widget_leaves.c", "src/hud_gadgets.c", "src/hud_radio.c", "src/services_cursor.c", "src/cpu_fault.c", "src/cpu_fault.S", "src/adapter_leaves.c"],
    hdrs = ["include/es2/sim/services.h", "include/es2/sim/cpu_fault.h", "include/es2/sim/files.h", "include/es2/sim/loop.h", "include/es2/sim/input.h", "include/es2/sim/load.h", "include/es2/sim/audio.h", "include/es2/sim/hud.h", "include/es2/sim/view.h", "include/es2/sim/dialogs.h", "include/es2/sim/gfx.h", "include/es2/sim/present.h", "include/es2/sim/poly.h", "include/es2/sim/scene.h", "include/es2/sim/terrain_draw.h", "include/es2/sim/shape_draw.h", "include/es2/sim/frustum.h", "include/es2/sim/fill.h", "include/es2/sim/gouraud.h", "include/es2/sim/cursor.h", "include/es2/sim/process_platform.h"],
    textual_hdrs = ["dispatch/services.h", ":services_rows"] + glob(["dispatch/services/*.h"]),
    strip_include_prefix = "include",
    deps = [":dispatch", ":heap", ":image_data", ":memory", "//sim/oracle:virtual_time", "//sim/oracle:journal", "//core", "//formats:cfg", "//tools/reference-game/proxy:sha256_header", "//tools/reference-game/proxy:frame_regions_header"],
    copts = _COPTS,
    target_compatible_with = _X86_WINDOWS,
)

cc_library(
    name = "residue",
    srcs = ["src/residue.c"],
    hdrs = ["include/es2/sim/residue.h"],
    strip_include_prefix = "include",
    copts = _COPTS,
    target_compatible_with = _X86_WINDOWS,
)

# The registry's adapters compiled for the host (the dispatch table's hook rows).
cc_library(
    name = "adapters",
    srcs = ["src/adapters.c"],
    hdrs = ["include/es2/sim/adapters.h"],
    strip_include_prefix = "include",
    deps = [":dispatch", "//tools/reference-game/proxy:hook_adapters"],
    copts = ["-mstackrealign", "-Wno-unused-function"],
    # The adapter bridges' seam to the dispatch (proxy/sim_bridge.h).
    local_defines = ["ES2_SIM_HOST"],
    linkopts = ["-ladvapi32"],
    target_compatible_with = _X86_WINDOWS,
)

cc_library(
    name = "host",
    srcs = ["src/host.c"],
    hdrs = ["include/es2/sim/host.h"],
    strip_include_prefix = "include",
    deps = [
        ":adapters",
        ":dispatch",
        ":heap",
        ":image",
        ":image_access",
        ":image_data",
        ":memory",
        ":services",
        "//sim/oracle:journal",
        "//sim/oracle:mem_watch",
        "//sim/oracle:tick_record",
        "//sim/oracle:virtual_time",
    ],
    copts = _COPTS,
    target_compatible_with = _X86_WINDOWS,
)

cc_binary(
    name = "es2sim",
    srcs = ["src/main.c"],
    deps = [":host", ":host_fault", ":init", ":perf", ":startup", "//sim/oracle:snapshot", "//tools/reference-game/invitro:image_mapping"],
    copts = _COPTS,
    linkopts = _HOST_LINKOPTS,
    target_compatible_with = _X86_WINDOWS,
)

# ---------------------------------------------------------------------------
# Unit tests on synthetic images and tables (no game data).

cc_test(
    name = "image_test",
    srcs = ["tests/image_test.c"],
    deps = [":image_file"],
    copts = _COPTS,
    size = "small",
    target_compatible_with = _X86_WINDOWS,
)

# Synthetic tables; on the real file (ES2_DATA_ROOT, SKIP without) the
# registry and service VAs against CODE, the entries and the import thunks.
cc_test(
    # Not "dispatch_test": "patch" in an EXE name trips Windows' installer heuristic (error 740).
    name = "table_test",
    srcs = ["tests/table_test.c"],
    deps = [":adapters", ":dispatch", ":image", ":image_file", ":services"],
    data = ["@es2_data//:reference_binaries"],
    copts = _COPTS,
    size = "small",
    target_compatible_with = _X86_WINDOWS,
)

[cc_test(
    name = "trap_%s_test" % mode,
    srcs = ["tests/trap_test.c", "tests/trap_probe.S"],
    deps = [":dispatch", ":memory", ":services", "//tools/reference-game/proxy:hook_adapters"],
    args = [mode],
    copts = _COPTS,
    size = "small",
    tags = ["local", "no-remote", "no-cache"] if mode == "benchmark" else [],
    target_compatible_with = _X86_WINDOWS,
) for mode in ["calls", "refusal", "seh", "benchmark"]]

cc_test(
    name = "heap_test",
    srcs = ["tests/heap_test.c"],
    deps = [":heap", ":memory"],
    copts = _COPTS,
    size = "small",
    target_compatible_with = _X86_WINDOWS,
)

cc_test(
    name = "services_test",
    srcs = ["tests/services_test.c"],
    deps = [":dispatch", ":heap", ":memory", ":residue", ":services"],
    copts = _COPTS,
    size = "small",
    target_compatible_with = _X86_WINDOWS,
)

# The host's memory watches on the real image in-process: refused [trace]
# watches at set-up, the start record's count and the watch events after
# hand-written tick records (the image is built in; no data).
cc_test(
    name = "host_watch_real_test",
    srcs = ["tests/host_watch_real_test.c"],
    deps = [":host", "//tools/reference-game/invitro:image_mapping"],
    copts = _COPTS,
    linkopts = _HOST_LINKOPTS,
    size = "small",
    target_compatible_with = _X86_WINDOWS,
)

# The host on the real image in-process: claim, map, set-up, trapped calls
# through an adapter, services and refusals; built from the own tables, CODE
# no-access outside the table pages (no data needed).
cc_test(
    name = "host_real_test",
    srcs = ["tests/host_real_test.c", "tests/trap_probe.S"],
    deps = [":host", ":image_access", ":image_data", "//tools/reference-game/invitro:image_mapping"],
    copts = _COPTS + ["-Wno-unused-function"],
    linkopts = _HOST_LINKOPTS,
    size = "small",
    target_compatible_with = _X86_WINDOWS,
)

# es2sim.exe as a process: usage and `--headless` in a synthetic
# installation (no data needed).
cc_test(
    name = "es2sim_real_test",
    srcs = ["tests/es2sim_run_test.c"],
    data = [":es2sim"],
    args = ["$(rootpath :es2sim)"],
    copts = _COPTS,
    size = "small",
    target_compatible_with = _X86_WINDOWS,
)

