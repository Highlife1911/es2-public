    name = "replay_suite_test",
    main = "tests/replay_suite_test.py",
    data = [
        "tests/frames_known.py",
        "tests/replay_suite.py",
        "tests/replay_stub_sim.py",
        "tests/legacy_launch_set.py",
        "replay_tests.bzl",
