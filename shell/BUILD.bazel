# The layers, bottom to top (every library is private to this package; the
# few labels other packages use carry their own visibility):
#   //formats:*  ->  :flow  ->  :engine  ->  :screens  ->  :gui_app  ->  es2shell
#                    :flow  ->  :host (+ :help)  ->  es2menu / es2shell
#   :gui (portable frame, events, loop, headless) -> :gui_sdl (SDL3 window)
package(default_visibility = ["//visibility:private"])

# Little-endian byte access shared by every shell library.
cc_library(
    name = "bytes",
    hdrs = ["include/es2/shell/bytes.h"],
    strip_include_prefix = "include",
)

# The state half, portable C17 without file I/O or platform calls: mission
# preparation, SAV construction, slots, campaign and results path, practice,
# mission texts, text drawing (gui/text.c), the movie queue and the shell flow.
cc_library(
    name = "flow",
    srcs = ["src/prepare.c", "src/equipment.c", "src/equipment.h", "src/save.c", "src/campaign.c", "src/slots.c",
            "src/practice.c", "src/texts.c", "src/gui/text.c", "src/flow.c", "src/movies.c"],
    hdrs = ["include/es2/shell/prepare.h", "include/es2/shell/save.h", "include/es2/shell/campaign.h",
            "include/es2/shell/slots.h", "include/es2/shell/hangar.h",
            "include/es2/shell/editors.h",
            "include/es2/shell/practice.h", "include/es2/shell/texts.h", "include/es2/shell/gui/text.h",
            "include/es2/shell/flow.h",
            "include/es2/shell/movies.h"],
    strip_include_prefix = "include",
    deps = [":bytes", ":vshell_store", "//formats:dfn", "//formats:formats", "//formats:player_mec", "//formats:sav",
            "//formats:str"],
)

# The state engine over DATA/SAV (es2/shell/engine.h) and the menu logic of the
# text presenter (src/menu.h); portable, no file I/O (the file layer is
# src/engine_io.c in :host).
cc_library(
    name = "engine",
    srcs = ["src/engine.c", "src/menu_logic.c"],
    hdrs = ["include/es2/shell/engine.h", "src/menu.h"],
    includes = ["include", "src"],
    deps = [":bytes", ":flow", "//formats:formats", "//formats:sav", "//formats:str"],
)

cc_binary(
    name = "es2prep_core",
    srcs = ["tools/es2prep_core.c"],
    deps = [":flow"],
    visibility = ["//tools/reference-game:__subpackages__"],
)

