    srcs = ["src/host.c", "src/engine_io.c"],
    hdrs = ["src/host.h", "src/engine_io.h"],
    includes = ["src"],
    deps = [":help", ":engine", ":flow", ":vshell_store", "//formats:cfg", "//formats:formats", "//formats:sav",
            "//formats:sha256"],
    target_compatible_with = ["@platforms//os:windows"],
)

