# The graphical shell's presenter and host (src/gui/app.c): the shared
# host (src/host.c) under the screens of :screens, their resources from the
# installation's VOLs and the span store, the movie player and the sounds.
# gui_route_real_test drives es2shell --headless through Route A and the
# Saved games route and compares the files with es2menu's for the same choices.
cc_library(
    name = "gui_app",
    srcs = ["src/gui/app.c", "src/gui/app_sound.c"],
    hdrs = ["src/gui/app.h", "src/gui/app_sound.h"],
    includes = ["src"],
    deps = [":bytes", ":gui", ":gui_sound_sdl", ":host", ":mci_player", ":sounds", ":screens", "//formats:formats",
            "//formats:sav"],
    target_compatible_with = ["@platforms//os:windows", "@platforms//cpu:x86_32"],
)

host_python_test(
    name = "gui_route_real_test",
    main = "tests/test_gui_route_real.py",
    data = ["@es2_recorded//:outputs", ":es2shell", ":es2menu", ":gui_sdl_runtime", "@es2_data//:cd",
            "//tools/reference-game/shell-invitro:reference_pins.py"],
    args = ["$(rootpath :es2shell)", "$(rootpath :es2menu)",
            "$(rootpath //tools/reference-game/shell-invitro:reference_pins.py)"],
    size = "small",
    # Also reads the recorded outputs under es2-data (oracle/golden), tracked
