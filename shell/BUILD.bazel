# The VSHELL span store. shell/data/vshell_store_data.c
# is generated by tools/reference-game/scripts/vshell_store.py from the
# reference VSHELL.EXE (never by a build or test): the runs es2_shell_exe_span
# answers for ES2_VSHELL_STORE, the layout literals and VSHELL's class icon.
# vshell_store_test: the lookup and the refusals on the committed runs;
# vshell_store_real_test: every run and the icon equal the file, and every
# span the readers take lies in a run (skipped without ES2_DATA_ROOT).
cc_library(
    name = "vshell_store",
    srcs = ["src/vshell_store.c", "data/vshell_store_data.c"],
    hdrs = ["include/es2/shell/vshell_store.h"],
    strip_include_prefix = "include",
    deps = ["//formats:formats"],
)

cc_test(
    name = "vshell_store_test",
    srcs = ["tests/test_vshell_store.c"],
    deps = [":flow", ":vshell_store"],
    size = "small",
)

cc_test(
    name = "vshell_store_real_test",
    srcs = ["tests/test_vshell_store_real.c"],
    deps = [":engine", ":flow", ":screens", ":vshell_file", ":vshell_store", "//formats:sha256"],
    data = ["data/vshell_reads.txt", "@es2_data//:cd"],
