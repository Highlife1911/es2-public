# Campaign chain through the own launcher (es2chain.py). Synthetic loop
# tests; the real test runs the recorded suites' DBSIM outputs and a whole
# campaign through es2launch.exe and compares every step with the mapped
# original VSHELL (docs/reverse-engineering/launcher.md, "campaign chain
# through the own launcher").
host_python_test(
    name = "chain_test",
    main = "tests/test_chain.py",
    data = ["tools/es2chain.py", "tools/es2prep.py", "tools/es2campaign.py"],
    args = ["$(rootpath tools/es2chain.py)"],
)

host_python_test(
    name = "chain_real_test",
    main = "tests/test_chain_real.py",
    data = ["@es2_recorded//:outputs", "tools/es2chain.py", "tools/es2prep.py", "tools/es2campaign.py", ":es2prep_core",
            "tests/chain_fake_dbsim.py",
            "//launcher:es2launch", "//launcher:stand_in_child",
            "//tools/reference-game/shell-invitro:es2shellprep",
            "//tools/reference-game/shell-invitro:sweep_compare.py",
            "//tools/reference-game/shell-invitro:reference_pins.py",
            "//tools/reference-game/shell-invitro:slots_oracle.py",
            "@es2_data//:cd"],
    args = [
        "$(rootpath tools/es2chain.py)",
        "$(rootpath :es2prep_core)",
        "$(rootpath //tools/reference-game/shell-invitro:es2shellprep)",
        "$(rootpath //launcher:es2launch)",
        "$(rootpath //launcher:stand_in_child)",
        "$(rootpath tests/chain_fake_dbsim.py)",
        "$(rootpath //tools/reference-game/shell-invitro:sweep_compare.py)",
        "$(rootpath //tools/reference-game/shell-invitro:reference_pins.py)",
        "$(rootpath //tools/reference-game/shell-invitro:slots_oracle.py)",
    ],
    size = "medium",
    # Also reads the recorded outputs under es2-data (oracle/golden), tracked
    # by @es2_recorded//:outputs, and pinned SAV files of a clone (their
    # SHA-256 is in reference_pins.py): cacheable.
    tags = ["local"],
    target_compatible_with = ["@platforms//os:windows", "@platforms//cpu:x86_32"],
)

# Every results.dat/mission.var pair the suites wrote (goldens and
# regression runs under es2-data), checked against the static writer contract
# and run through es2campaign.py's results path and the mapped original VSHELL
# results path (docs/reverse-engineering/vshell_preparation.md, "results.dat
# corpus and round trip").
host_python_test(
    name = "results_corpus_real_test",
    main = "tests/test_results_corpus.py",
    data = ["tools/es2campaign.py", "tools/es2prep.py", "tools/es2loadout.py", ":es2prep_core",
            "//tools/reference-game/shell-invitro:es2shellprep",
            "//tools/reference-game/shell-invitro:results_compare.py",
            "//tools/reference-game/shell-invitro:sweep_compare.py",
            "//tools/reference-game/shell-invitro:reference_pins.py",
            "@es2_data//:cd"],
    args = [
        "$(rootpath tools/es2campaign.py)",
        "$(rootpath :es2prep_core)",
        "$(rootpath //tools/reference-game/shell-invitro:es2shellprep)",
        "$(rootpath //tools/reference-game/shell-invitro:results_compare.py)",
        "$(rootpath //tools/reference-game/shell-invitro:reference_pins.py)",
    ],
    size = "medium",
    # Also reads every recorded suite output under es2-data, which @es2_data
    # does not track: stays out of the shared caches, and `external` makes it run
    # every time (trap: a cached PASSED hides new evidence that breaks it).
    tags = ["local", "no-cache", "external"],
    target_compatible_with = ["@platforms//os:windows", "@platforms//cpu:x86_32"],
)

# The host both presenters share (src/host.c: menu.ini, the flow's file
# layer over engine_io, slots, practice launch, CD check, online manual).
cc_library(
