            "//launcher:es2launch", "//launcher:stand_in_child",
            "//tools/reference-game/shell-invitro:reference_pins.py",
            "//tools/reference-game/shell-invitro:es2shellprep",
            "//tools/reference-game/shell-invitro:slots_oracle.py",
            "@es2_data//:cd"],
    args = [
        "$(rootpath :es2menu)",
        "$(rootpath tools/es2menu_backend.py)",
        "$(rootpath tools/es2chain.py)",
        "$(rootpath :es2prep_core)",
        "$(rootpath //launcher:es2launch)",
        "$(rootpath //launcher:stand_in_child)",
        "$(rootpath tests/chain_fake_dbsim.py)",
        "$(rootpath //tools/reference-game/shell-invitro:reference_pins.py)",
        "$(rootpath //tools/reference-game/shell-invitro:es2shellprep)",
        "$(rootpath //tools/reference-game/shell-invitro:slots_oracle.py)",
    ],
    size = "medium",
    # Also reads the recorded outputs under es2-data (oracle/golden), tracked
    # by @es2_recorded//:outputs, and pinned SAV files of a clone (their
    # SHA-256 is in reference_pins.py): cacheable.
    tags = ["local"],
    target_compatible_with = ["@platforms//os:windows", "@platforms//cpu:x86_32"],
)

# Save slots, the new career, the SAV after a load and after a
# preparation, byte for byte against VSHELL's own functions in the mapped
# original (slot mode of the memory worker). Skipped without ES2_DATA_ROOT.
cc_test(
    name = "slots_real_test",
    srcs = ["//bazel/defs:python_test.c"],
    data = ["@es2_recorded//:outputs", "tests/test_slots_real.py", "tests/shard.py",
            "//tools/reference-game/shell-invitro:es2shellprep.py"] + BACKEND_DATA,
    args = [
        HOST_PYTHON,
        "-B",
        "$(rootpath tests/test_slots_real.py)",
        "$(rootpath tools/es2prep.py)",
        "$(rootpath tools/es2menu_backend.py)",
        "$(rootpath :es2prep_core)",
        "$(rootpath //tools/reference-game/shell-invitro:es2shellprep)",
        "$(rootpath //tools/reference-game/shell-invitro:slots_oracle.py)",
        "$(rootpath //tools/reference-game/shell-invitro:es2shellprep.py)",
        "$(rootpath //tools/reference-game/shell-invitro:reference_pins.py)",
    ],
    size = "medium",
    # 3 shards; case n of the numbered cases (tests/test_slots_real.py) runs in shard n % 3.
    shard_count = 3,
    # Also reads the recorded outputs under es2-data (oracle/golden), tracked
    # by @es2_recorded//:outputs, and pinned SAV files of a clone (their
    # SHA-256 is in reference_pins.py): cacheable.
    tags = ["local"],
    target_compatible_with = ["@platforms//os:windows", "@platforms//cpu:x86_32"],
)

# The sharded real tests are cc_test targets running the pinned Python through the generic
# runner, as host_python_test does (host_python_test has no shard_count): Bazel's TEST_TOTAL_SHARDS /
# TEST_SHARD_INDEX select the cases in tests/shard.py, which every sharded test lists as data.
#
# The service bay's WEAPONS operations (es2/shell/hangar.h) and the
# launch-file writer, byte for byte against VSHELL's own 0x411b10, 0x43e346,
# 0x412a37, 0x40f68c and 0x41501f in the mapped original (slot mode of the
# memory worker). Skipped without ES2_DATA_ROOT.
cc_test(
    name = "bay_real_test",
    srcs = ["//bazel/defs:python_test.c"],
    data = ["@es2_recorded//:outputs", "tests/test_bay_real.py", "tests/shard.py"] + BACKEND_DATA,
    args = [
        HOST_PYTHON,
        "-B",
        "$(rootpath tests/test_bay_real.py)",
        "$(rootpath tools/es2loadout.py)",
        "$(rootpath tools/es2menu_backend.py)",
        "$(rootpath :es2prep_core)",
        "$(rootpath //tools/reference-game/shell-invitro:es2shellprep)",
        "$(rootpath //tools/reference-game/shell-invitro:slots_oracle.py)",
        "$(rootpath //tools/reference-game/shell-invitro:reference_pins.py)",
    ],
    size = "medium",
    # Shard 0 tallies the coverage of every seeded sequence on our side; shards 1..3 own the comparisons
    # with the original (tests/test_bay_real.py, docstring).
    shard_count = 4,
    # Also reads the recorded outputs under es2-data (oracle/golden), tracked
    # by @es2_recorded//:outputs, and pinned SAV files of a clone (their
    # SHA-256 is in reference_pins.py): cacheable.
    tags = ["local"],
    target_compatible_with = ["@platforms//os:windows", "@platforms//cpu:x86_32"],
)

