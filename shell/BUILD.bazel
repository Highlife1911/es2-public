    name = "menu_real_test",
    main = "tests/test_menu_real.py",
    data = ["@es2_recorded//:outputs", ":es2menu", "tools/es2menu_backend.py", "tools/es2chain.py", "tools/es2prep.py", "tools/es2loadout.py",
