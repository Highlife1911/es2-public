"""A generated header that includes a glob of fragment headers.

Lists that every package extends (the service rows of sim/dispatch) live as
one fragment file per package; this rule writes the header that includes
them, sorted by path, so adding a package adds a file and touches no shared
line. Only for lists whose order does not matter.
"""

def _include_list_impl(ctx):
    out = ctx.actions.declare_file(ctx.attr.out)
    paths = sorted([f.short_path for f in ctx.files.srcs])
    ctx.actions.write(out, "".join(
        ["/* Generated by bazel/defs/include_list.bzl (%s); do not edit. */\n" % ctx.label] +
        ["#include \"%s\"\n" % p for p in paths],
    ))
    return [DefaultInfo(files = depset([out]))]

include_list = rule(
    implementation = _include_list_impl,
    doc = "Writes `out` with one #include per header of `srcs`, sorted by path.",
    attrs = {
        "srcs": attr.label_list(allow_files = [".h"], mandatory = True),
        "out": attr.string(mandatory = True),
    },
)
