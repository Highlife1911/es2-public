load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load(":config.bzl", "llvm_mingw_config")

package(default_visibility = ["//visibility:public"])
exports_files(["repository.bzl"])
filegroup(name = "empty")

[
    filegroup(
        name = arch + "_files",
        srcs = ["@llvm_mingw//:tools", "@llvm_mingw//:common_headers", "@llvm_mingw//:" + arch + "_sdk"],
    )
    for arch in ["i686", "x86_64"]
]

[
    llvm_mingw_config(
        name = arch + "_config",
        arch = arch,
        compiler = "@llvm_mingw//:sdk/bin/" + arch + "-w64-mingw32-clang.exe",
        archiver = "@llvm_mingw//:sdk/bin/llvm-ar.exe",
        strip = "@llvm_mingw//:sdk/bin/llvm-strip.exe",
    )
    for arch in ["i686", "x86_64"]
]

[
    cc_toolchain(
        name = arch + "_cc",
        toolchain_identifier = "llvm-mingw-20260922-" + arch,
        toolchain_config = ":" + arch + "_config",
        all_files = ":" + arch + "_files",
        compiler_files = ":" + arch + "_files",
        linker_files = ":" + arch + "_files",
        ar_files = "@llvm_mingw//:tools",
        strip_files = "@llvm_mingw//:tools",
        objcopy_files = ":empty",
        dwp_files = ":empty",
        supports_param_files = 0,
    )
    for arch in ["i686", "x86_64"]
]

toolchain(
    name = "windows_x86",
    toolchain = ":i686_cc",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    exec_compatible_with = ["@platforms//os:windows", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:windows", "@platforms//cpu:x86_32"],
)
toolchain(
    name = "windows_x86_64",
    toolchain = ":x86_64_cc",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    exec_compatible_with = ["@platforms//os:windows", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:windows", "@platforms//cpu:x86_64"],
)
